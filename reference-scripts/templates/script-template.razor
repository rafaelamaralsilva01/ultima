############   EDIT BELOW THIS LINE AT YOUR OWN RISK!   ############


if not timerexists "MainTimer"
    createtimer "MainTimer"
    settimer "MainTimer" 0
endif

if not dead
    if SCRIPTRESET = 1
        # unsetvar de toda variável persistente/sessão que este script usa
        @setvar! TimeToGo 0
        overhead "All permanent script variables reset!" 84
        sysmsg "Make sure to set SCRIPTRESET back to 0" 253
        stop
    endif
endif

while not dead
    while queued
        wait 100
    endwhile

    # LOOP PRINCIPAL AQUI
    # Regras (ver PATTERNS.md):
    #   - nunca usar () pra agrupar condição, usar if aninhado
    #   - nunca ID numérico de item se existir nome
    #   - sempre 'as' pra capturar resultado de findtype que será reusado
    #   - overhead com hue consistente por severidade

    wait 250
endwhile
replay


